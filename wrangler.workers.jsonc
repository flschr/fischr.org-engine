{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Die Workers-Variante von wrangler.jsonc, absichtlich als zweite Datei.
  //
  // Solange die Produktion auf Pages läuft, dürfen sich beide nicht ins Gehege kommen: Ein
  // `_worker.js` im Ausgabeverzeichnis würde Pages in seinen Advanced Mode versetzen und den
  // laufenden Deploy verändern. Deshalb erzeugt `npm run build:site` diese Datei nicht — nur
  // `npm run build:worker` tut das — und deshalb steht diese Konfiguration daneben statt darin.
  //
  // Beim Umschalten wird daraus wrangler.jsonc, und wrangler.jsonc entfällt.
  //
  // Der Name ist nicht "fischr-org": Workers und Pages-Projekte teilen sich im Dashboard einen
  // Namensraum, und dieser Name gehört noch dem Pages-Projekt. Erst wenn das abgeschaltet wird,
  // ist er wieder frei — bis dahin ist ein eigener Name ohnehin richtiger, weil beide parallel
  // existieren sollen.
  "name": "fischr-org-site",

  // Hier steht bewusst weder "routes" noch "custom_domain". mysite.example hängt über eine Route auf
  // Zonenebene an diesem Worker (Muster "mysite.example/*"), angelegt über die API und nur dort
  // sichtbar — /workers/scripts/.../domains und /accounts/.../workers/domains sind leer und
  // haben schon eine fremde Session auf die falsche Fährte geführt.
  //
  // Route statt Custom Domain, weil eine Domain erst vom Pages-Projekt gelöst werden müsste und
  // dazwischen eine Lücke entstünde. Eine Route greift vor der Pages-Domain, ohne dass etwas
  // gelöst wird — das Pages-Projekt bleibt bestehen und ist der Rückweg: Route löschen, Pages
  // bedient wieder. Deshalb wird Pages weiterhin als Domain geführt, obwohl es nichts mehr
  // ausliefert.
  //
  // www.mysite.example deckt die Route nicht ab und braucht es nicht: Der Hostname antwortet mit
  // einer Weiterleitung auf den Apex.
  "compatibility_date": "2026-08-23",
  // Nicht direkt das generierte Bündel: worker/index.js reicht dessen Handler durch und
  // exportiert daneben die Workflow-Klasse. Ein von `pages functions build` erzeugtes Bündel
  // kann sie nicht mitbringen, die Laufzeit braucht sie aber als eigenen Export.
  "main": "./worker/index.js",

  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",

    // Der Punkt, an dem die Migration still kaputtgehen könnte: Pages führt Functions VOR den
    // statischen Dateien aus, Workers macht es genau umgekehrt. Ohne diese Liste würde
    // /feed.xml von der gebauten Datei bedient statt von functions/feed.xml.js — die Seite
    // sähe völlig normal aus, und die Feed-Zählung hörte lautlos auf.
    //
    // Die Einträge sind eins zu eins die "include"-Liste aus blog/_routes.json, die unter Pages
    // dieselbe Frage beantwortet hat. Wer dort etwas ergänzt, muss es hier ergänzen; ein Test
    // in tests/workflow-validation.test.js hält die beiden zusammen.
    "run_worker_first": [
      "/feed.xml",
      "/admin",
      "/admin/*",
      "/api/admin/*",
      "/api/github/*",
      "/api/hit"
    ],

    // Die Seite hat eine eigene 404-Seite; ohne das käme eine nackte Cloudflare-Fehlerseite.
    "not_found_handling": "404-page"
  },

  // Unverändert aus wrangler.jsonc übernommen — Bindungen sind zwischen Pages und Workers
  // gleich aufgebaut. Die Gründe stehen dort und werden hier bewusst nicht verdoppelt.
  // Die Veröffentlichung als Zustandsmaschine. Sie baut nicht selbst — Eleventy, sharp und
  // ffmpeg brauchen einen Checkout, den ein Worker nicht hat. Sie ordnet: prüft den Stand,
  // stösst den Bau in Actions an, wartet ihn ab und hält fest, wo sie steht. Genau das fehlte,
  // als zwei YAML-Dateien und Commit-Marker diese Rolle übernehmen mussten.
  "workflows": [
    {
      "name": "fischr-publish",
      "binding": "PUBLISH",
      "class_name": "PublishWorkflow"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "fischr-media"
    }
  ],

  "d1_databases": [
    {
      "binding": "ANALYTICS",
      "database_name": "fischr-analytics-eu",
      "database_id": "49a984ad-3f98-41d7-b968-7ddae2f8822c",
      "preview_database_id": "87f5a68f-55dc-4208-bf1e-7e47c2122fbb"
    }
  ]
}
