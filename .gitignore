node_modules
_site/
# Without the trailing slash the rule also covers a symlinked cache, the way node_modules and
# the media directories already do — a second checkout shares the build cache instead of
# regenerating 1 GB of responsive images.
.cache
.env
.env.*
!.env.example
.DS_Store
npm-debug.log*
playwright-report/
test-results/
blog/admin/vendor/
blog/assets/css/generated/
# Media originals are no longer committed to Git (DB-1129) — canonically stored in R2 and
# materialized here at build time by scripts/prepare-media-source.js from
# automation/media-manifest.json.
blog/assets/images
blog/assets/videos
