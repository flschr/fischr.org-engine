node_modules
_site/
# Without the trailing slash the rule also covers a symlinked cache, the way node_modules and
# the media directories already do — a second checkout shares the build cache instead of
# regenerating 1 GB of responsive images.
.cache
.env
.env.*
!.env.example
.DS_Store
npm-debug.log*
playwright-report/
test-results/
blog/admin/vendor/
blog/assets/css/generated/
# Media originals are no longer committed to Git (DB-1129) — canonically stored in R2 and
# materialized here at build time by scripts/prepare-media-source.js from
# automation/media-manifest.json.
blog/assets/images
blog/assets/videos

# Lokaler Zustand von wrangler (pages dev, Caches). Ohne diese Regel landet der
# Inhalt beim naechsten `git add -A` im Commit.
.wrangler/

# Bericht aus scripts/report-media-drift.js. Bewusst nicht eingecheckt: ein eingecheckter
# Bericht veraltet still und wird dann geglaubt (siehe das entfernte
# unreferenced-media-report.json). Der Workflow haengt ihn als Artefakt an den Lauf.
automation/media-drift-report.json
