---
permalink: /site.webmanifest
eleventyExcludeFromCollections: true
---
{
  "name": {{ site.title | dump | safe }},
  "short_name": {{ site.title | dump | safe }},
  "description": {{ site.description | dump | safe }},
  "start_url": "/",
  "scope": "/",
  "display": "minimal-ui",
  "background_color": "{{ site.themeColor }}",
  "theme_color": "{{ site.themeColor }}",
  "icons": [
    {
      "src": "/assets/images/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/assets/images/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/assets/images/icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/assets/images/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
