  async function toggleStatsRowDrill(event) {
    const toggle = event.target.closest(".stats-row-toggle");
    if (!toggle) return;
    // closest statt parentElement: Der Knopf sitzt neben dem Öffnen-Link in
    // einer eigenen Zeile, die Unterliste eine Ebene darüber.
    const panel = toggle.closest(".stats-row-group").querySelector(".stats-subrefs");
    const expanded = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", expanded ? "false" : "true");
    panel.hidden = expanded;
    if (expanded || panel.dataset.state === "loaded" || panel.dataset.state === "loading") return;

    panel.dataset.state = "loading";
    panel.innerHTML = `<p class="stats-substate">Wird geladen …</p>`;
    try {
      const bounds = statsPeriodBounds(state.statsPeriod);
      if (!bounds) throw new Error("Zeitraum unvollständig");
      const { start, end } = bounds;
      const drill = `${toggle.dataset.drillKey}=${encodeURIComponent(toggle.dataset.drillId)}`;
      const query = `${drill}&start=${encodeURIComponent(start)}&end=${encodeURIComponent(end)}`;
      const response = await fetch(`/api/admin/analytics?${query}`, { credentials: "same-origin", headers: { Accept: "application/json" } });
      if (!response.ok) throw new Error(`Anfrage fehlgeschlagen (${response.status})`);
      const data = await response.json();
      panel.innerHTML = statsBesucherZeile(data.visitors) + statsSubList(data.rows || [], toggle.dataset.drillKey);
      panel.dataset.state = "loaded";
      // Die Unterzeilen tragen Öffnen-Links mit Symbol; anders als beim
      // Neuzeichnen der ganzen Ansicht kommt hier kein Durchlauf mehr hinterher.
      if (window.RWIcons) window.RWIcons.inject(panel);
    } catch (error) {
      panel.innerHTML = `<p class="stats-substate stats-state-error">${escapeHtml(error.message)}</p>`;
      panel.dataset.state = ""; // allow a retry on next expand
    }
  }

  // Nur die Besucherzahl, ohne sie zu den Aufrufen ins Verhältnis zu setzen.
  //
  // Import und eigene Messung gelten als eine Quelle — so soll das Dashboard
  // sich lesen. Besucher gibt es aber erst ab der eigenen Messung, Aufrufe
  // schon davor. "48 Aufrufe von 10 Besuchern" behauptete deshalb ein
  // Verhältnis, das aus zwei verschiedenen Zeiträumen stammt. Die Zahl allein
  // behauptet nichts: Sie ist, was gemessen wurde.
  function statsBesucherZeile(besucher) {
    const zahl = Number(besucher);
    if (!Number.isFinite(zahl) || zahl <= 0) return "";
    return `<p class="stats-substate stats-subvisitors">${numberFormat.format(zahl)} Besucher</p>`;
  }

  // Was eine Unterzeile bedeutet, hängt daran, was aufgeklappt wurde:
  //   Seite      → die Quellen, die auf sie geführt haben (fremde Hosts)
  //   Quelle     → die Seiten, die sie gebracht hat (eigene Pfade)
  //   "unbekannt" → die rohen Programmkennungen dahinter
  //
  // Der Schlüssel entscheidet deshalb, wohin ein Öffnen-Link zeigt — und ob es
  // überhaupt einen gibt. Eine Programmkennung ist kein Ort.
  function statsUnterzeilenUrl(key, name) {
    if (key === "ref") return statsSeitenUrl(name);
    if (key === "path") return statsQuellenUrl(name);
    return null;
  }

  // Die Kennungen brauchen einen Satz Erklärung, die anderen Unterlisten nicht:
  // Unter einer Seite stehen Quellen, das erklärt sich. Eine Liste roher
  // Programmkennungen tut das nicht.
  const STATS_UNTERHINWEIS = {
    reader: "Kennungen ohne erkanntes Leseprogramm — daraus wächst die Erkennung"
  };

  function statsSubList(rows, key) {
    const items = (rows || [])
      .filter((row) => Number(row.count) > 0)
      .map((row) => ({
        name: row.name || "(unbekannt)",
        count: Number(row.count),
        href: statsUnterzeilenUrl(key, row.name)
      }));
    if (!items.length) return `<p class="stats-substate">Keine weiteren Angaben.</p>`;
    const max = items.reduce((peak, row) => Math.max(peak, row.count), 0);
    const list = items.map((row) => {
      const teile = statsZeilenTeile(row, max);
      return `<li class="stats-row stats-subrow${teile.link ? " stats-row-linked" : ""}">` +
        `${teile.bar}${teile.text}${teile.value}${teile.link}</li>`;
    }).join("");
    const hinweis = STATS_UNTERHINWEIS[key]
      ? `<p class="stats-substate">${escapeHtml(STATS_UNTERHINWEIS[key])}</p>`
      : "";
    return `${hinweis}<ol class="stats-rows stats-subrows">${list}</ol>`;
  }

  // Die Adresse, unter der eine Zeile tatsächlich zu sehen ist.
  //
  // Zwei Richtungen, zwei Funktionen: ein eigener Pfad wird an die Adresse
  // dieser Seite gehängt, eine fremde Quelle ist ein Host. Beide geben null
  // zurück, wenn die Zeile kein Ort ist — "(direkt)" ist keine Website, und ein
  // Pfad aus fremder Quelle wird nicht ungeprüft zu einer Adresse gemacht.
  function statsSeitenUrl(path) {
    if (typeof path !== "string" || !/^\/(?!\/)/.test(path)) return null;
    const basis = (state.socialConfig?.siteUrl || "https://mysite.example").replace(/\/$/, "");
    return `${basis}${path}`;
  }

  function statsQuellenUrl(host) {
    return /^[a-z0-9-]+(\.[a-z0-9-]+)+$/i.test(host || "") ? `https://${host}/` : null;
  }

  // Der Öffnen-Link am Zeilenende. Er steht bewusst außerhalb des Aufklapp-
  // Knopfes: Ein Link in einem Knopf ist kein gültiges Markup, und beide sollen
  // getrennt anklickbar sein.
  function statsOeffnenLink(href, name) {
    if (!href) return "";
    return `<a class="stats-row-open" href="${escapeHtml(href)}" target="_blank" rel="noopener noreferrer"` +
      ` title="Öffnen" aria-label="${escapeHtml(name)} in neuem Tab öffnen">` +
      `<span data-icon="external-link" aria-hidden="true"></span></a>`;
  }

  // Eine Zeile ohne Zahl fällt aus jeder Liste — sie hätte nichts zu zeigen.
  // Es sei denn, sie bringt ihre eigene Beschriftung mit: Ein Leseprogramm ohne
  // Abonnentenschätzung gehört in die Liste, mit einem Strich statt einer Null.
  function statsZeileSichtbar(row) {
    return Boolean(row) && (Number(row.count) > 0 || Boolean(row.wert));
  }

  // Die Bestandteile einer Zeile, einmal gebaut für alle Listen: Balken, Text,
  // Zahl, Öffnen-Link. Vorher stand dieselbe Rechnung in drei Funktionen, und
  // jede Änderung an der Zeile musste in dreien nachgezogen werden.
  function statsZeilenTeile(row, max) {
    const count = Number(row.count) || 0;
    const width = max > 0 ? Math.max(2, Math.round((count / max) * 100)) : 0;
    const sub = row.title ? `<span class="stats-row-title">${escapeHtml(row.title)}</span>` : "";
    return {
      bar: `<div class="stats-row-bar" style="--w:${width}%"></div>`,
      text: `<div class="stats-row-text"><span class="stats-row-path">${escapeHtml(row.name || "/")}</span>${sub}</div>`,
      value: `<span class="stats-row-count">${row.wert ? escapeHtml(row.wert) : numberFormat.format(count)}</span>`,
      link: statsOeffnenLink(row.href, row.name || "/")
    };
  }

  // Listen enden nach zehn Zeilen. Die Seitenliste hatte fünfundzwanzig
  // Einträge und machte die Ansicht länger als alles andere zusammen; unten
  // stehen ohnehin Zeilen mit einem einzigen Treffer. Der Rest bleibt im
  // Markup und wird nur ausgeblendet — ein Klick zeigt ihn, ohne dass eine
  // zweite Anfrage nötig wäre.
  const STATS_ZEILEN = 10;

  function statsPanelRahmen(title, zeilen) {
    const versteckt = Math.max(0, zeilen.length - STATS_ZEILEN);
    const liste = zeilen.map((zeile, index) =>
      index < STATS_ZEILEN ? zeile : zeile.replace("<li ", `<li hidden data-stats-mehr="1" `)
    ).join("");
    const mehr = versteckt
      ? `<button type="button" class="stats-more">${versteckt} weitere anzeigen</button>`
      : "";
    // Kein Platz für eine Zeile Erklärung unter dem Titel: Jede Liste hier
    // heißt nach dem, was in ihr steht, und was die Zahlen genau zählen, steht
    // in der Dokumentation und nicht über sieben Zeilen Liste. Wo eine Liste
    // ohne Satz nicht auskam, war der Titel das Problem.
    return `<section class="stats-panel"><h2 class="stats-panel-title">${escapeHtml(title)}</h2>` +
      `<ol class="stats-rows">${liste}</ol>${mehr}</section>`;
  }

  function statsBreakdownPanel(title, rows) {
    const items = (rows || []).filter(statsZeileSichtbar);
    const max = items.reduce((peak, row) => Math.max(peak, Number(row.count) || 0), 0);
    const body = items.length
      ? items.map((row) => {
          const teile = statsZeilenTeile(row, max);
          return `<li class="stats-row${teile.link ? " stats-row-linked" : ""}">` +
            `${teile.bar}${teile.text}${teile.value}${teile.link}</li>`;
        })
      : [`<li class="stats-row stats-row-empty">Keine Daten</li>`];
    return statsPanelRahmen(title, body);
  }
