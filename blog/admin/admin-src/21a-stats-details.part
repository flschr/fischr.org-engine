  async function toggleStatsRowDrill(event) {
    const toggle = event.target.closest(".stats-row-toggle");
    if (!toggle) return;
    const panel = toggle.parentElement.querySelector(".stats-subrefs");
    const expanded = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", expanded ? "false" : "true");
    panel.hidden = expanded;
    if (expanded || panel.dataset.state === "loaded" || panel.dataset.state === "loading") return;

    panel.dataset.state = "loading";
    panel.innerHTML = `<p class="stats-substate">Wird geladen …</p>`;
    try {
      const bounds = statsPeriodBounds(state.statsPeriod);
      if (!bounds) throw new Error("Zeitraum unvollständig");
      const { start, end } = bounds;
      const drill = `${toggle.dataset.drillKey}=${encodeURIComponent(toggle.dataset.drillId)}`;
      const query = `${drill}&start=${encodeURIComponent(start)}&end=${encodeURIComponent(end)}`;
      const response = await fetch(`/api/admin/analytics?${query}`, { credentials: "same-origin", headers: { Accept: "application/json" } });
      if (!response.ok) throw new Error(`Anfrage fehlgeschlagen (${response.status})`);
      const data = await response.json();
      panel.innerHTML = statsBesucherZeile(data.visitors) + statsSubList(data.rows || []);
      panel.dataset.state = "loaded";
    } catch (error) {
      panel.innerHTML = `<p class="stats-substate stats-state-error">${escapeHtml(error.message)}</p>`;
      panel.dataset.state = ""; // allow a retry on next expand
    }
  }

  // Nur die Besucherzahl, ohne sie zu den Aufrufen ins Verhältnis zu setzen.
  //
  // Import und eigene Messung gelten als eine Quelle — so soll das Dashboard
  // sich lesen. Besucher gibt es aber erst ab der eigenen Messung, Aufrufe
  // schon davor. "48 Aufrufe von 10 Besuchern" behauptete deshalb ein
  // Verhältnis, das aus zwei verschiedenen Zeiträumen stammt. Die Zahl allein
  // behauptet nichts: Sie ist, was gemessen wurde.
  function statsBesucherZeile(besucher) {
    const zahl = Number(besucher);
    if (!Number.isFinite(zahl) || zahl <= 0) return "";
    return `<p class="stats-substate stats-subvisitors">${numberFormat.format(zahl)} Besucher</p>`;
  }

  function statsSubList(rows) {
    const items = (rows || [])
      .filter((row) => Number(row.count) > 0)
      .map((row) => ({ name: row.name || "(unbekannt)", count: Number(row.count) }));
    if (!items.length) return `<p class="stats-substate">Keine weiteren Angaben.</p>`;
    const max = items.reduce((peak, row) => Math.max(peak, row.count), 0);
    const list = items.map((row) => {
      const width = max > 0 ? Math.max(2, Math.round((row.count / max) * 100)) : 0;
      return [
        `<li class="stats-row stats-subrow">`,
        `<div class="stats-row-bar" style="--w:${width}%"></div>`,
        `<div class="stats-row-text"><span class="stats-row-path">${escapeHtml(row.name)}</span></div>`,
        `<span class="stats-row-count">${numberFormat.format(row.count)}</span>`,
        `</li>`
      ].join("");
    }).join("");
    return `<ol class="stats-rows stats-subrows">${list}</ol>`;
  }

  // Listen enden nach zehn Zeilen. Die Seitenliste hatte fünfundzwanzig
  // Einträge und machte die Ansicht länger als alles andere zusammen; unten
  // stehen ohnehin Zeilen mit einem einzigen Treffer. Der Rest bleibt im
  // Markup und wird nur ausgeblendet — ein Klick zeigt ihn, ohne dass eine
  // zweite Anfrage nötig wäre.
  const STATS_ZEILEN = 10;

  function statsPanelRahmen(title, zeilen) {
    const versteckt = Math.max(0, zeilen.length - STATS_ZEILEN);
    const liste = zeilen.map((zeile, index) =>
      index < STATS_ZEILEN ? zeile : zeile.replace("<li ", `<li hidden data-stats-mehr="1" `)
    ).join("");
    const mehr = versteckt
      ? `<button type="button" class="stats-more">${versteckt} weitere anzeigen</button>`
      : "";
    return `<section class="stats-panel"><h2 class="stats-panel-title">${escapeHtml(title)}</h2>` +
      `<ol class="stats-rows">${liste}</ol>${mehr}</section>`;
  }

  function statsBreakdownPanel(title, rows, options = {}) {
    const items = (rows || []).filter((row) => row && Number(row.count) > 0);
    const max = items.reduce((peak, row) => Math.max(peak, Number(row.count) || 0), 0);
    const body = items.length
      ? items.map((row) => {
          const count = Number(row.count) || 0;
          const width = max > 0 ? Math.max(2, Math.round((count / max) * 100)) : 0;
          const label = options.isPath
            ? `<span class="stats-row-path">${escapeHtml(row.name || "/")}</span>${row.title ? `<span class="stats-row-title">${escapeHtml(row.title)}</span>` : ""}`
            : `<span class="stats-row-path">${escapeHtml(row.name)}</span>`;
          return [
            `<li class="stats-row">`,
            `<div class="stats-row-bar" style="--w:${width}%"></div>`,
            `<div class="stats-row-text">${label}</div>`,
            `<span class="stats-row-count">${numberFormat.format(count)}</span>`,
            `</li>`
          ].join("");
        })
      : [`<li class="stats-row stats-row-empty">Keine Daten</li>`];
    return statsPanelRahmen(title, body);
  }

  // A compact inline sparkline of the daily visit series.
  function statsSparkline(series) {
    const points = series
      .map((entry) => {
        if (typeof entry.daily === "number") return entry.daily;
        if (Array.isArray(entry.hourly)) return entry.hourly.reduce((sum, value) => sum + (value || 0), 0);
        return 0;
      });
    if (points.length < 2) return "";

    const max = Math.max(1, ...points);
    const width = 100;
    const height = 28;
    const step = width / (points.length - 1);
    const coords = points.map((value, index) => {
      const x = index * step;
      const y = height - (value / max) * (height - 2) - 1;
      return `${x.toFixed(2)},${y.toFixed(2)}`;
    });
    const area = `0,${height} ${coords.join(" ")} ${width},${height}`;
    return [
      `<svg class="stats-spark" viewBox="0 0 ${width} ${height}" preserveAspectRatio="none" aria-hidden="true">`,
      `<polygon class="stats-spark-fill" points="${area}" />`,
      `<polyline class="stats-spark-line" points="${coords.join(" ")}" />`,
      `</svg>`
    ].join("");
  }
