  // --- Stats (GoatCounter) -------------------------------------------------
  //
  // A small read-only dashboard. The browser only ever talks to
  // /api/admin/stats, which proxies GoatCounter server-side with the
  // admin-level API token — that token never reaches the client.

  const STATS_RANGES = { 7: "Last 7 days", 30: "Last 30 days", 90: "Last 90 days", 365: "Last 12 months" };
  const numberFormat = new Intl.NumberFormat("en-US");

  // The Stats tab is shown unless settings explicitly turn it off (default on).
  function statsEnabled() {
    const stats = state.socialConfig?.stats;
    return !stats || stats.enabled !== false;
  }

  function applyStatsTabVisibility() {
    if (els.statsNav) els.statsNav.hidden = !statsEnabled();
    // If the tab gets turned off while it's open, fall back to the library.
    if (!statsEnabled() && state.view === "stats") setCollection("posts");
  }

  // GoatCounter wants hour-rounded ISO timestamps.
  function statsRange(days) {
    const end = new Date();
    end.setMinutes(0, 0, 0);
    const start = new Date(end);
    start.setDate(start.getDate() - Number(days));
    start.setHours(0, 0, 0, 0);
    return { start: start.toISOString(), end: end.toISOString() };
  }

  async function openStats() {
    // Always land on the weekly range, regardless of the last range picked.
    state.statsDays = 7;
    showView("stats");
    pushNav();
    setStatsRangeButtons();
    await loadStats();
  }

  function setStatsRangeButtons() {
    if (!els.statsRange) return;
    els.statsRange.querySelectorAll(".stats-range-btn").forEach((button) => {
      button.classList.toggle("is-active", Number(button.dataset.days) === state.statsDays);
    });
    if (els.statsRangeLabel) els.statsRangeLabel.textContent = STATS_RANGES[state.statsDays] || "";
  }

  // Numbers are fetched live, but cached in memory per range for a few minutes
  // so flipping between ranges (or leaving and reopening the tab) is instant and
  // doesn't hammer the GoatCounter API. The refresh button forces a live reload.
  const STATS_CACHE_TTL = 5 * 60 * 1000;

  function sharedStatsRequest(days, force = false) {
    if (!force) {
      const cached = state.statsCache.get(days);
      if (cached && Date.now() - cached.at < STATS_CACHE_TTL) return Promise.resolve(cached.data);
      if (state.statsPromises.has(days)) return state.statsPromises.get(days);
    }
    state.statsControllers.get(days)?.abort();
    const controller = new AbortController();
    state.statsControllers.set(days, controller);
    const { start, end } = statsRange(days);
    const promise = fetch(`/api/admin/stats?start=${encodeURIComponent(start)}&end=${encodeURIComponent(end)}`, {
      credentials: "same-origin",
      headers: { Accept: "application/json" },
      signal: controller.signal
    }).then(async (response) => {
      if (!response.ok) {
        const error = new Error(`Statistikanfrage fehlgeschlagen (${response.status})`);
        error.status = response.status;
        throw error;
      }
      const data = await response.json();
      state.statsCache.set(days, { at: Date.now(), data });
      return data;
    }).finally(() => {
      if (state.statsPromises.get(days) === promise) state.statsPromises.delete(days);
      if (state.statsControllers.get(days) === controller) state.statsControllers.delete(days);
    });
    state.statsPromises.set(days, promise);
    return promise;
  }

  async function loadStats(force = false) {
    if (!els.statsBody) return;
    const request = ++state.statsRequest;

    els.statsBody.innerHTML = `<p class="stats-state">Wird geladen …</p>`;
    try {
      const data = await sharedStatsRequest(state.statsDays, force);
      if (request !== state.statsRequest) return;
      renderStats(data);
    } catch (error) {
      if (request !== state.statsRequest) return;
      if (error.name === "AbortError") return;
      if (error.status === 401) {
        els.statsBody.innerHTML = `<p class="stats-state">Melde dich über die Einstellungen bei GitHub an, um die Statistik zu sehen.</p>`;
        return;
      }
      if (error.status === 503) {
        els.statsBody.innerHTML = `<p class="stats-state">Der GoatCounter-API-Token ist noch nicht konfiguriert.</p>`;
        return;
      }
      if (error.status === 403) {
        els.statsBody.innerHTML = `<p class="stats-state">Die Statistik ist in den Einstellungen deaktiviert.</p>`;
        return;
      }
      els.statsBody.innerHTML = `<p class="stats-state stats-state-error">Stats could not be loaded: ${escapeHtml(error.message)}</p>`;
    }
  }

  function renderStats(data) {
    const total = data.total || {};
    const totalVisits = Number(total.total || 0);
    const series = Array.isArray(total.stats) ? total.stats : [];

    const panels = [
      statsExpandablePanel("Top pages", (data.hits?.hits || []).map((hit) => ({
        name: hit.path || "/",
        title: hit.title,
        count: Number(hit.count) || 0,
        drill: hit.path_id ? { key: "path_id", id: hit.path_id } : null
      }))),
      statsExpandablePanel("Top referrers", (data.toprefs?.stats || []).map((stat) => ({
        name: stat.name || "(unknown)",
        count: Number(stat.count) || 0,
        drill: stat.id ? { key: "ref_id", id: stat.id } : null
      }))),
      statsBreakdownPanel("Browsers", (data.browsers?.stats || []).map(statsStat)),
      statsBreakdownPanel("Systems", (data.systems?.stats || []).map(statsStat)),
      statsBreakdownPanel("Locations", (data.locations?.stats || []).map(statsStat))
    ];

    els.statsBody.innerHTML = [
      `<div class="stats-total">`,
      `<div class="stats-total-head"><span class="stats-total-label">Total visits</span><span class="stats-total-value">${numberFormat.format(totalVisits)}</span></div>`,
      statsSparkline(series),
      `</div>`,
      `<div class="stats-grid">${panels.join("")}</div>`
    ].join("");
    // The page rows carry chevron icons rendered after innerHTML — inject them.
    if (window.RWIcons) window.RWIcons.inject(els.statsBody);
  }

  // A panel whose rows can expand to a lazily-loaded sub-list:
  //   Top pages     → the referrers that sent visits to that page
  //   Top referrers → the specific source URLs behind that referrer
  // Rows without a `drill` descriptor render as plain, non-expandable rows.
  function statsExpandablePanel(title, rows) {
    const items = (rows || []).filter((row) => Number(row.count) > 0);
    const max = items.reduce((peak, row) => Math.max(peak, Number(row.count) || 0), 0);
    const body = items.length
      ? items.map((row) => {
          const count = Number(row.count) || 0;
          const width = max > 0 ? Math.max(2, Math.round((count / max) * 100)) : 0;
          const sub = row.title ? `<span class="stats-row-title">${escapeHtml(row.title)}</span>` : "";
          const text = `<div class="stats-row-text"><span class="stats-row-path">${escapeHtml(row.name)}</span>${sub}</div>`;
          const bar = `<div class="stats-row-bar" style="--w:${width}%"></div>`;
          const value = `<span class="stats-row-count">${numberFormat.format(count)}</span>`;
          if (!row.drill) {
            return `<li class="stats-row-group"><div class="stats-row stats-row-plain">${bar}${text}${value}</div></li>`;
          }
          return [
            `<li class="stats-row-group">`,
            `<button type="button" class="stats-row stats-row-toggle" data-drill-key="${escapeHtml(row.drill.key)}" data-drill-id="${escapeHtml(String(row.drill.id))}" aria-expanded="false">`,
            `<span class="stats-row-chevron" data-icon="chevron-down" aria-hidden="true"></span>`,
            bar,
            text,
            value,
            `</button>`,
            `<div class="stats-subrefs" hidden></div>`,
            `</li>`
          ].join("");
        }).join("")
      : `<li class="stats-row stats-row-empty">No data</li>`;
    return `<section class="stats-panel"><h2 class="stats-panel-title">${escapeHtml(title)}</h2><ol class="stats-rows">${body}</ol></section>`;
  }
