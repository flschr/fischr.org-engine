  async function refreshMedia(force) {
    if (!hasGithubAccess()) {
      const changes = await loadChanges();
      state.media = changes
        .filter((change) => change.collection === "media" && change.kind === "upsert" && change.mediaKind !== "gpx" && !isGpxPath(change.path) && isMediaLibraryPath(change.path))
        .map((change) => {
          const publicPath = change.publicPath || publicMediaPath(change.path);
          const kind = change.mediaKind || (isVideoPath(change.path) ? "video" : "image");
          return {
            path: change.path,
            publicPath,
            name: fileName(change.path),
            size: change.size || 0,
            sha: "",
            pending: true,
            preview: change.preview || "",
            mediaKind: kind,
            entryDate: "",
            entryPath: "",
            entrySort: 0,
            uploadSort: Date.parse(change.updatedAt || "") || 0,
            poster: kind === "video" ? videoPosterPath(publicPath) : "",
            references: [],
            duplicate: false
          };
        })
        .sort(collections.media.sort);
      renderMedia();
      attachMediaReferences(null, changes);
      return;
    }
    const tree = await fetchTree(force);
    state.entryLookup = buildEntryLookup(tree.tree || []);
    const changes = await loadChanges();
    const deleted = new Set(changes.filter((change) => change.kind === "delete").map((change) => change.path));
    const pendingByPath = new Map(changes.filter((change) => change.collection === "media").map((change) => [change.path, change]));

    const remote = tree.tree
      .filter((item) => item.type === "blob")
      .filter((item) => (item.path.startsWith(`${collections.media.dir}/`) || item.path.startsWith(`${collections.media.videoDir}/`)) && isMediaLibraryPath(item.path))
      .filter((item) => !deleted.has(item.path))
      .map((item) => {
        const referencedEntry = referencedEntryFromMediaPath(item.path);
        const publicPath = publicMediaPath(item.path);
        const kind = isVideoPath(item.path) ? "video" : "image";
        return {
          path: item.path,
          publicPath,
          name: fileName(item.path),
          size: item.size || 0,
          sha: item.sha,
          pending: pendingByPath.has(item.path),
          preview: pendingByPath.get(item.path)?.preview || "",
          mediaKind: kind,
          entryDate: referencedEntry?.date || "",
          entryPath: referencedEntry?.path || "",
          entrySort: referencedEntry?.sortKey || 0,
          uploadSort: mediaDateSortValue(item.path),
          poster: kind === "video" ? videoPosterPath(publicPath) : ""
        };
      });
    const remotePaths = new Set(remote.map((item) => item.path));

    const local = changes
      .filter((change) => change.collection === "media" && change.kind === "upsert" && change.mediaKind !== "gpx" && !isGpxPath(change.path) && isMediaLibraryPath(change.path) && !remotePaths.has(change.path))
      .map((change) => {
        const referencedEntry = referencedEntryFromMediaPath(change.path);
        const publicPath = change.publicPath || publicMediaPath(change.path);
        const kind = change.mediaKind || (isVideoPath(change.path) ? "video" : "image");
        return {
          path: change.path,
          publicPath,
          name: fileName(change.path),
          size: change.size || 0,
          sha: "",
          pending: true,
          preview: change.preview || "",
          mediaKind: kind,
          entryDate: referencedEntry?.date || "",
          entryPath: referencedEntry?.path || "",
          entrySort: referencedEntry?.sortKey || 0,
          uploadSort: Date.parse(change.updatedAt || "") || mediaDateSortValue(change.path),
          poster: kind === "video" ? videoPosterPath(publicPath) : ""
        };
      });

    const media = [...remote, ...local]
      .map((item) => ({ ...item, references: [] }))
      .sort(collections.media.sort);
    const shaCounts = countValues(media.map((item) => item.sha).filter(Boolean));
    state.media = media.map((item) => ({
      ...item,
      duplicate: Boolean(item.sha && shaCounts.get(item.sha) > 1)
    }));
    renderMedia();
    attachMediaReferences(tree, changes);
  }

  // Reference info ("which post uses this image") needs the body of every post,
  // which is dozens of GitHub round-trips. It is purely informational, so we
  // build it in the background and patch it onto the already-rendered media
  // instead of blocking the gallery or the social-image picker on it.
  async function attachMediaReferences(tree, changes) {
    try {
      await refreshMediaReferenceIndex(tree, changes);
    } catch {
      return;
    }
    if (!state.media.length) return;
    state.media = state.media
      .map((item) => ({ ...item, references: mediaReferencesForItem(item) }))
      .sort(collections.media.sort);
    refreshRenderedMediaMetadata();
  }

  function countValues(values) {
    const counts = new Map();
    values.forEach((value) => counts.set(value, (counts.get(value) || 0) + 1));
    return counts;
  }
