          <!-- Settings view: GitHub connection (sync) + social configuration -->
          <section id="socialConfigView" class="view social-config-view settings-view" aria-label="Einstellungen" hidden>
            <div class="library-head view-head">
              <h1 class="view-title" data-i18n="viewTitle.settings">Settings</h1>
            </div>

            <!-- GitHub connection (its own save: OAuth / token). -->
            <div id="connectionPanel" class="setup-card">
              <div class="setup-head">
                <span id="connectionDot" class="connection-dot" aria-hidden="true"></span>
                <h2 class="setup-title" data-i18n="settings.githubConnection">GitHub connection</h2>
                <span id="connectionState" class="setup-state">nicht verbunden</span>
              </div>
              <div class="setup-body">
                <p id="connectionText" class="setup-text">Mit GitHub anmelden, um Beiträge und Medien zu laden und Änderungen zu veröffentlichen.</p>
                <p id="connectionUser" class="setup-user" hidden></p>
                <div class="setup-actions">
                  <a id="loginButton" class="primary-action" href="/api/admin/auth/login?return_to=/admin/">Mit GitHub anmelden</a>
                  <a id="logoutButton" class="ghost" href="/api/admin/auth/logout" hidden>Abmelden</a>
                </div>
                <details id="tokenFallback" class="token-fallback" hidden>
                  <summary>Token-Ersatz</summary>
                  <p class="setup-text">Nur verwenden, solange GitHub OAuth noch nicht eingerichtet ist.</p>
                  <input id="tokenInput" type="password" autocomplete="off" spellcheck="false" placeholder="github_pat_… or ghp_…">
                  <div class="setup-actions">
                    <button id="saveTokenButton" type="button" class="primary-action">Verbinden</button>
                    <button id="clearTokenButton" type="button" class="ghost">Trennen</button>
                  </div>
                </details>
              </div>
            </div>

            <!-- Pure client preference, not part of automation/social-config.json:
                 it never leaves this device, so it gets no save/reset button of
                 its own and takes effect the moment it's picked. -->
            <div class="settings-card">
              <div class="settings-card-head"><h3 class="settings-card-title" data-i18n="settings.language">Language</h3></div>
              <p class="settings-card-hint" data-i18n="settings.languageHint">Language of the admin interface. Applies only to this device.</p>
              <div class="settings-fields">
                <label class="settings-field">
                  <select id="adminLangSelect">
                    <option value="de">Deutsch</option>
                    <option value="en">English</option>
                  </select>
                </label>
              </div>
            </div>

            <!-- Syndication config — the cards below are saved together. -->
            <div class="settings-section-head">
              <h2 class="section-title">Distribution</h2>
              <div class="library-tools">
                <span id="socialConfigStatus" class="social-config-status"></span>
                <button id="socialConfigReset" type="button" class="ghost" disabled>
                  <span data-icon="refresh-cw" aria-hidden="true"></span>
                  <span>Zurücksetzen</span>
                </button>
                <button id="socialConfigSave" type="button" class="primary-action" disabled>
                  <span data-icon="save" aria-hidden="true"></span>
                  <span>Speichern</span>
                </button>
              </div>
            </div>
            <p class="social-config-intro">Vorgaben für neue Beiträge bei GoToSocial. Weitere Verteilung übernimmt der Server.</p>

            <div class="settings-card">
              <div class="settings-card-head"><h3 class="settings-card-title" data-i18n="settings.publishingDestination">Publishing destination</h3></div>
              <p class="settings-card-hint">Wohin neue Beiträge veröffentlicht werden.</p>
              <div class="settings-fields">
                <label class="settings-field"><span data-i18n="settings.gotosocialInstance">GoToSocial instance</span><input id="cfgGotosocialInstance" type="text" inputmode="url" autocomplete="off" spellcheck="false" placeholder="https://social.example.org"></label>
              </div>
            </div>

            <details class="settings-card settings-advanced">
              <summary>
                <span class="summary-text">
                  <span class="settings-card-title">Erweitert</span>
                  <span class="settings-card-hint">Zeitplan-Einstellungen – die Vorgaben passen meistens</span>
                </span>
              </summary>
              <div class="settings-fields">
                <label class="settings-field"><span>Maximale Beiträge pro Lauf</span><input id="cfgMaxPostsPerRun" type="number" min="1" step="1" inputmode="numeric"><small>Anzahl der Beiträge pro geplantem Lauf.</small></label>
                <label class="settings-field"><span>Maximales Alter in Tagen</span><input id="cfgMaxAgeDays" type="number" min="0" step="1" inputmode="numeric"><small>Ältere Beiträge überspringen.</small></label>
                <label class="settings-field"><span>Nicht veröffentlichen vor</span><input id="cfgStartAfter" type="datetime-local" autocomplete="off"><small>Frühere Beiträge überspringen; leer bedeutet unbegrenzt.</small></label>
              </div>
            </details>

            <div class="settings-section">
              <div class="settings-card-head">
                <h3 class="settings-card-title" data-i18n="settings.postTypes">Post types</h3>
                <button id="socialConfigAdd" type="button" class="ghost">
                  <span data-icon="plus" aria-hidden="true"></span>
                  <span>Hinzufügen</span>
                </button>
              </div>
              <p class="settings-card-hint">Wiederverwendbare Vorlagen zum Teilen. Ohne Auswahl gilt die Vorgabe.</p>
              <label class="settings-field"><span>Standard-Beitragstyp</span><select id="cfgDefaultCategory"></select></label>
              <div id="socialCategoryList" class="social-category-list"></div>
            </div>
          </section>
